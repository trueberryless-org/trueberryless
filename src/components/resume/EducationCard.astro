---
interface Props {
  education: {
    institution: string;
    degree: string | null;
    fieldOfStudy: string | null;
    grade: string | null;
    description: string | null;
  };
}

const { education } = Astro.props;

const subline = [education.degree, education.fieldOfStudy]
  .filter(Boolean)
  .join(" · ");
---

<div class="education-card">
  <h3 class="education-title">{education.institution}</h3>
  {subline && <p class="education-degree">{subline}</p>}
  {education.grade && <p class="education-grade">Grade: {education.grade}</p>}
  {
    education.description && (
      <p class="education-desc">{education.description}</p>
    )
  }
</div>

<style>
  .education-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .education-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .education-degree {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .education-grade {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .education-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }
</style>
