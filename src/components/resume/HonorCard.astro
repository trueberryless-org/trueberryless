---
import ExternalIcon from "@/components/utils/ExternalIcon.astro";

interface Props {
  honor: {
    title: string;
    issuer: string | null;
    awardedAt: string | null;
    description: string | null;
  };
}

const { honor } = Astro.props;

const desc = honor.description?.trim() ?? "";
const isUrl = /^https?:\/\/\S+$/i.test(desc);
---

<div class="honor-card">
  <div class="honor-header">
    <h3 class="honor-title">{honor.title}</h3>
    {honor.awardedAt && <span class="honor-date">{honor.awardedAt}</span>}
  </div>

  <div class="honor-meta">
    {honor.issuer && <span class="honor-issuer">{honor.issuer}</span>}
    {
      isUrl && (
        <a
          href={desc}
          class="honor-link"
        >
          <ExternalIcon size={12} class="honor-link-icon" />
          <span>Link</span>
        </a>
      )
    }
  </div>

  {desc && !isUrl && <p class="honor-desc">{desc}</p>}
</div>

<style>
  .honor-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  .honor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .honor-title {
    flex: 1;
    min-width: 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .honor-date {
    flex-shrink: 0;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .honor-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .honor-issuer {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .honor-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .honor-link:hover {
    color: var(--text);
    opacity: 0.8;
  }

  .honor-link-icon {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .honor-link:hover .honor-link-icon {
    transform: translate(1px, -1px);
  }

  .honor-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    overflow-wrap: break-word;
  }

  @media (prefers-reduced-motion: reduce) {
    .honor-link,
    .honor-link-icon {
      transition: none;
    }
    .honor-link:hover .honor-link-icon {
      transform: none;
    }
  }
</style>
