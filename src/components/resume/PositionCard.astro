---
import { MapPin } from "@lucide/astro";

interface Props {
  position: {
    title: string;
    company: string;
    location: string | null;
    jobType: string | null;
    workplaceType: string | null;
    description: string | null;
    skills: string[];
  };
}

const { position } = Astro.props;

const meta: string[] = [];
if (position.jobType) meta.push(position.jobType);
if (position.workplaceType) meta.push(position.workplaceType);
---

<div class="position-card">
  <h3 class="position-title">{position.title}</h3>
  <p class="position-company">{position.company}</p>

  {
    meta.length > 0 && (
      <div class="position-badges">
        {meta.map((m) => (
          <span class="badge">{m}</span>
        ))}
      </div>
    )
  }

  {
    position.location && (
      <div class="position-location">
        <MapPin class="loc-icon" width={14} height={14} />
        <span>{position.location}</span>
      </div>
    )
  }

  {position.description && <p class="position-desc">{position.description}</p>}

  {
    position.skills.length > 0 && (
      <div class="position-skills">
        {position.skills.map((s) => (
          <span class="skill-chip">{s}</span>
        ))}
      </div>
    )
  }
</div>

<style>
  .position-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .position-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .position-company {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .position-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .badge {
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--badge-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 2px 10px;
  }

  .position-location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .loc-icon {
    flex-shrink: 0;
  }

  .position-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .position-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .skill-chip {
    font-size: 0.75rem;
    color: var(--text);
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 2px 8px;
  }
</style>
