---
interface Props {
  start: string;
  end?: string | null;
  isCurrent?: boolean;
}

const { start, end, isCurrent = false } = Astro.props;
const endLabel = isCurrent ? "present" : end;
const cardClass = isCurrent ? "card-container card-current" : "card-container";
const endDotClass = isCurrent ? "dot dot-end dot-present" : "dot dot-end";
---

<div class="timeline-row">
  <div class="timeline-date">
    <span class="date-line date-end">{endLabel ?? "—"}</span>
    <span class="date-line date-start">{start}</span>
  </div>

  <div class="timeline-marker">
    <div class={endDotClass}></div>
    <div class="dot dot-start"></div>
  </div>

  <div class={cardClass}>
    <div class="card-content">
      <slot />
    </div>
  </div>
</div>

<style>
  .timeline-row {
    display: flex;
    width: 100%;
    margin-bottom: 36px;
    position: relative;
    box-sizing: border-box;
  }

  .timeline-date {
    width: 100px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: left;
    padding-right: 16px;
  }

  .date-line {
    font-size: 1rem;
    color: var(--text);
    line-height: 1.5;
    white-space: nowrap;
  }

  .date-end {
    align-self: flex-start;
    font-weight: 600;
  }

  .date-start {
    align-self: flex-start;
  }

  .timeline-marker {
    width: 40px;
    flex-shrink: 0;
    position: relative;
    display: flex;
    justify-content: center;
  }

  .timeline-marker::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: -36px;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    border-left: 1px dashed var(--border);
  }

  .timeline-row:last-child .timeline-marker::before {
    bottom: 0;
  }

  .dot {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    z-index: 2;
  }

  .dot-end {
    top: 8px;
    background-color: var(--text-muted);
  }

  .dot-start {
    bottom: 8px;
    background-color: var(--text-muted);
  }

  .dot-present {
    background-color: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .card-container {
    flex: 1;
    position: relative;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 20px 24px;
    min-width: 0;
  }

  .card-current {
    border: 2px dashed var(--accent);
  }

  @media (max-width: 768px) {
    .timeline-row {
      flex-direction: column;
      margin-bottom: 24px;
    }

    .timeline-date {
      width: 100%;
      flex-direction: row;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 10px;
      padding: 0;
      margin-bottom: 10px;
    }

    .date-start {
      order: -1;
    }

    .timeline-marker {
      display: none;
    }

    .card-container {
      padding: 16px 20px;
    }
  }
</style>
